# Secrets for the weekend kit. Generate each as a fresh random string:
#   openssl rand -hex 24
# Copy this file to .env in the same directory and fill every value.
# The evaluate key is what your payout path/API caller uses; the read key is
# for dashboards/analysts; the admin key controls state changes and canary
# registration — guard it like a root password.
PAYREKHA_EVALUATE_KEY=
PAYREKHA_READ_KEY=
PAYREKHA_ADMIN_KEY=
# Hashing key for beneficiary identifiers (hashed-at-edge, raw never stored).
PAYREKHA_HASH_KEY=
# Snapshot integrity key — required so state survives restarts untampered.
PAYREKHA_STATE_KEY=
# Shared secret Envoy presents on every ext_authz check request.
PAYREKHA_EXT_AUTHZ_KEY=
# Grafana admin login at http://localhost:3000
GRAFANA_ADMIN_PASSWORD=
