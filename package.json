{
  "name": "payrekha",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Payrekha — open-source, in-process payout firewall for Indian BFSI. No matching intent, no payout — whoever is calling your API.",
  "license": "Apache-2.0",
  "author": "Kapil <kapil@theproduct.city>",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/rules",
    "packages/store-postgres",
    "packages/gateway",
    "packages/replay"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "npm run build && node --test --test-reporter=spec \"packages/*/test/*.test.ts\"",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include=\"packages/*/dist/**\" --test-coverage-lines=85 --test-coverage-branches=75 --test-coverage-functions=80 \"packages/*/test/*.test.ts\"",
    "demo": "tsc -b && node examples/demo.mjs",
    "demo:live": "tsc -b && node examples/live-demo.mjs",
    "gateway": "tsc -b && node examples/reference-gateway.mjs",
    "bench": "tsc -b && node --expose-gc benchmarks/run.mjs",
    "replay": "tsc -b && node packages/replay/dist/cli.js",
    "gen:data": "tsc -b && node tools/generate-synthetic-data.mjs",
    "check:deps": "node tools/check-zero-deps.mjs",
    "check:openapi": "node scripts/check-openapi.mjs",
    "loadcheck": "npm run build >/dev/null && node scripts/load-check.mjs",
    "drill:crash": "npm run build >/dev/null && node scripts/drill-crash.mjs",
    "publish:check": "tsc -b && npm publish --workspaces --dry-run --tag alpha",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "playground": "tsc -b && esbuild playground/entry.mjs --bundle --format=esm --target=es2022 --outfile=playground/payrekha-web.js --alias:node:crypto=./playground/shims/node-crypto.mjs --alias:node:fs=./playground/shims/node-fs.mjs --inject:playground/shims/buffer.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peopleofproduct/payrekha.git"
  },
  "homepage": "https://github.com/peopleofproduct/payrekha#readme",
  "bugs": "https://github.com/peopleofproduct/payrekha/issues",
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
