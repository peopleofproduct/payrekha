{
  "name": "@payrekha/replay",
  "version": "0.1.0-alpha.2",
  "description": "Run historical payouts through the PayRekha rules and get a terminal, HTML and JSON report. The zero-integration evaluation tool.",
  "license": "Apache-2.0",
  "author": "Kapil <kapil@theproduct.city>",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "payrekha-replay": "dist/cli.js"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@payrekha/core": "0.1.0-alpha.0",
    "@payrekha/rules": "0.1.0-alpha.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peopleofproduct/payrekha.git",
    "directory": "packages/replay"
  },
  "homepage": "https://github.com/peopleofproduct/payrekha#readme",
  "bugs": {
    "url": "https://github.com/peopleofproduct/payrekha/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "payrekha",
    "payout",
    "fraud",
    "firewall",
    "upi",
    "imps",
    "neft",
    "nbfc",
    "payment-aggregator",
    "cert-in",
    "india"
  ]
}
