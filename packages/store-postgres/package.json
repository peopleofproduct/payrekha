{
  "name": "@payrekha/store-postgres",
  "version": "0.1.0-alpha.0",
  "description": "Postgres state store for Payrekha: durable firewall snapshots with optimistic versioning, so a second writer is detected instead of silently overwriting HIGH_ALERT.",
  "license": "Apache-2.0",
  "author": "Kapil <kapil@theproduct.city>",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@payrekha/core": "0.1.0-alpha.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peopleofproduct/payrekha.git",
    "directory": "packages/store-postgres"
  },
  "homepage": "https://github.com/peopleofproduct/payrekha#readme",
  "bugs": {
    "url": "https://github.com/peopleofproduct/payrekha/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "payrekha",
    "postgres",
    "state",
    "payout",
    "firewall"
  ]
}
